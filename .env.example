# Server
PORT=3000
DATA_DIR=/app/data

# Nextcloud (gunakan app password, bukan password akun utama)
NEXTCLOUD_URL=https://cloud.contoh.com
NEXTCLOUD_USERNAME=nama-pengguna
NEXTCLOUD_APP_PASSWORD=isi_app_password
NEXTCLOUD_REMOTE_DIR=/Foto-Peserta

# Google Drive OAuth 2.0 (opsional)
# Redirect URI harus sama persis dengan URI yang didaftarkan di Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://foto.contoh.com/auth/google/callback
# Opsional: ID folder Google Drive tujuan. Kosong = My Drive.
GOOGLE_DRIVE_FOLDER_ID=
